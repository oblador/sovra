{
  "compilerOptions": {
    "target": "es2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["es2024"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "test", "__fixtures__"]
}
